   "source": [
    "def natural_sum(n):\n",
    "    if n <= 0:\n",
    "        return 0\n",
    "    return n + natural_sum(n - 1)\n",
    "\n",
    "n = int(input())\n",
    "print(natural_sum(n))"
   ]
  }
