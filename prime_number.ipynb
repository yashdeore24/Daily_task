   ],
   "source": [
    "\n",
    "num = int(input())\n",
    "\n",
    "if num <= 1:\n",
    "    print(\"Not Prime\")\n",
    "else:\n",
    "    i = 2\n",
    "    while i < num:\n",
    "        if num % i == 0:\n",
    "            print(\"Not Prime\")\n",
    "            break\n",
    "        i += 1\n",
    "    else:\n",
    "        print(\"Prime\")\n"
   ]
